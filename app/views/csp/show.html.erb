<%# Build marker: view-source and search "csp-build" to confirm which deploy is live. Bump on every deploy. %>
<!-- csp-build: 246d209c -->
<div class="@container space-y-8 pb-6 lg:pb-12">
  <header>
    <div class="flex items-center gap-2">
      <h1 class="text-2xl font-semibold text-primary"><%= t(".title") %></h1>
      <%= render DS::Pill.new(label: t("shared.preview"), size: :md) %>
    </div>
    <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>
  </header>

  <%# Month navigator %>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-1">
      <%= link_to csp_path(month_year: @prev_month_param, **budget_owner_query),
          class: "p-2 rounded-lg hover:bg-container-inset text-secondary",
          title: t(".prev_month"),
          aria: { label: t(".prev_month") } do %>
        <%= icon("chevron-left") %>
      <% end %>
      <h2 class="text-lg font-medium text-primary min-w-44 text-center"><%= @month_label %></h2>
      <%= link_to csp_path(month_year: @next_month_param, **budget_owner_query),
          class: "p-2 rounded-lg hover:bg-container-inset text-secondary",
          title: t(".next_month"),
          aria: { label: t(".next_month") } do %>
        <%= icon("chevron-right") %>
      <% end %>
    </div>
    <div class="bg-container rounded-xl shadow-border-xs px-5 py-3">
      <p class="text-[11px] font-medium uppercase tracking-wide text-secondary"><%= t(".take_home") %></p>
      <p class="text-xl font-medium text-primary tabular-nums privacy-sensitive"><%= format_money(Money.new(@plan.income, @budget.family.currency)) %></p>
      <% if @plan.manual_income? %>
        <p class="text-[11px] text-secondary mt-0.5"><%= t(".take_home_manual") %></p>
      <% end %>
      <details class="mt-2">
        <summary class="text-xs text-secondary cursor-pointer hover:text-primary"><%= t(".take_home_edit") %></summary>
        <%= form_with url: csp_take_home_pay_path(month_year: @budget.to_param), method: :patch, class: "mt-2 flex items-center gap-2" do |f| %>
          <%= f.number_field :take_home_pay, value: @budget.family.csp_take_home_pay,
                step: "0.01", min: "0", placeholder: t(".take_home_placeholder"),
                class: "w-32 rounded-md border border-primary bg-container-inset px-2 py-1 text-sm text-primary tabular-nums" %>
          <%= f.submit t(".take_home_save"), class: "rounded-md bg-primary px-3 py-1 text-sm font-medium text-white hover:opacity-90" %>
        <% end %>
        <p class="text-[11px] text-secondary mt-1"><%= t(".take_home_hint") %></p>
      </details>
    </div>
  </div>

  <%# Bucket cards %>
  <section class="grid grid-cols-1 @2xl:grid-cols-2 @4xl:grid-cols-4 gap-4">
    <% { "fixed_costs" => "receipt", "investments" => "trending-up", "savings" => "piggy-bank", "guilt_free" => "sparkles" }.each do |key, icon_name| %>
      <% bucket = @plan.buckets.find { |b| b.key == key } %>
      <% status_tone = { on_track: :success, below: :warning, above: :destructive }[bucket.status] %>
      <% bar_tone = { on_track: "bg-success", below: "bg-warning", above: "bg-destructive" }[bucket.status] %>
      <div class="bg-container rounded-xl shadow-border-xs p-5 space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <%= render DS::FilledIcon.new(icon: icon_name, variant: :container, size: "sm") %>
            <p class="text-sm font-medium text-primary"><%= t("csp.buckets.#{key}") %></p>
          </div>
          <%= render DS::Pill.new(label: t(".status.#{bucket.status}"), tone: status_tone, size: :sm) %>
        </div>
        <div>
          <p class="text-2xl font-medium text-primary tabular-nums privacy-sensitive"><%= format_money(Money.new(bucket.actual, @budget.family.currency)) %></p>
          <p class="text-sm text-secondary tabular-nums"><%= t(".of_take_home", percent: bucket.percent) %></p>
        </div>
        <%# Progress bar with target band %>
        <div class="relative h-2 rounded-full bg-container-inset overflow-hidden" role="img" aria-label="<%= t("csp.buckets.#{key}") %>: <%= bucket.percent %>% — <%= t("csp.bands.#{key}") %>">
          <% band_min = bucket.band_min || 0 %>
          <% band_max = bucket.band_max || 100 %>
          <% base_pct = [ bucket.percent - bucket.basis_boost_percent, 100 ].min %>
          <% boost_pct = [ bucket.basis_boost_percent, 100 - base_pct ].min %>
          <div class="absolute inset-y-0 bg-success/20" style="left: <%= band_min %>%; width: <%= band_max - band_min %>%;"></div>
          <div class="absolute inset-y-0 left-0 <%= bar_tone %> rounded-full" style="width: <%= base_pct %>%;"></div>
          <% if boost_pct.positive? %>
            <div class="absolute inset-y-0 bg-green-300 rounded-full" style="left: <%= base_pct %>%; width: <%= boost_pct %>%;"></div>
          <% end %>
        </div>
        <p class="text-xs text-secondary"><%= t("csp.bands.#{key}") %> · <%= t(".categories_count", count: bucket.category_count) %><% if bucket.transfer_count.positive? %> · <%= t(".transfers_count", count: bucket.transfer_count) %><% end %><% if bucket.basis_boost_amount.positive? %> · <%= t(".basis_yield_boost", amount: format_money(Money.new(bucket.basis_boost_amount, @budget.family.currency)), apy: bucket.basis_apy) %><% end %></p>
      </div>
    <% end %>
  </section>

  <%# Unassigned callout %>
  <% if @plan.unassigned_actual.positive? %>
    <%= render DS::Alert.new(
      message: t(".unassigned.body",
        amount: format_money(Money.new(@plan.unassigned_actual, @budget.family.currency)),
        percent: @plan.unassigned_percent),
      variant: :warning) %>
  <% end %>

  <%# Bucket assignment setup %>
  <section class="bg-container rounded-xl shadow-border-xs p-5 space-y-4">
    <div>
      <h3 class="text-base font-medium text-primary"><%= t(".setup.title") %></h3>
      <p class="text-sm text-secondary mt-1"><%= t(".setup.subtitle") %></p>
    </div>

    <%= form_with url: csp_buckets_path(month_year: @budget.to_param, **budget_owner_query), method: :patch do %>
      <div class="divide-y divide-secondary">
        <div class="grid grid-cols-12 gap-3 pb-2 text-[11px] font-medium uppercase tracking-wide text-secondary">
          <p class="col-span-6"><%= t(".setup.category") %></p>
          <p class="col-span-3 text-right"><%= t(".setup.spent_this_month") %></p>
          <p class="col-span-3"><%= t(".setup.bucket") %></p>
        </div>
        <% @plan.top_level_budget_categories.sort_by { |bc| bc.category.display_name.downcase }.each do |bc| %>
          <% category = bc.category %>
          <div class="grid grid-cols-12 gap-3 items-center py-2.5">
            <div class="col-span-6 flex items-center gap-2.5 min-w-0">
              <span class="size-2.5 rounded-full shrink-0" style="background-color: <%= category.color %>;"></span>
              <p class="text-sm text-primary truncate"><%= category.display_name %></p>
              <% if category.subcategories.any? %>
                <p class="text-xs text-tertiary shrink-0">+<%= category.subcategories.count %></p>
              <% end %>
            </div>
            <p class="col-span-3 text-sm text-secondary tabular-nums text-right privacy-sensitive"><%= format_money(Money.new(bc.actual_spending.to_d, @budget.family.currency)) %></p>
            <div class="col-span-3">
              <%= select_tag "category_buckets[#{category.id}]",
                  options_for_select([ [ t(".setup.unassigned_option"), "" ] ] + @bucket_options, category.csp_bucket),
                  class: "form-field__input w-full text-sm" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="pt-4 flex justify-end">
        <%= render DS::Button.new(text: t(".setup.save"), type: :submit) %>
      </div>
    <% end %>
  </section>

  <%# Account transfer bucket assignments — funds_movement nets to zero in the
      budget, so assign each account's net transfer to a bucket here %>
  <section class="bg-container rounded-xl shadow-border-xs p-5 space-y-4">
    <div>
      <h3 class="text-base font-medium text-primary"><%= t(".transfers.title") %></h3>
      <p class="text-sm text-secondary mt-1"><%= t(".transfers.subtitle") %></p>
    </div>

    <% if @plan.transfer_rows.any? %>
      <%= form_with url: csp_buckets_path(month_year: @budget.to_param, **budget_owner_query), method: :patch do %>
        <div class="divide-y divide-secondary">
          <div class="grid grid-cols-12 gap-3 pb-2 text-[11px] font-medium uppercase tracking-wide text-secondary">
            <p class="col-span-6"><%= t(".transfers.account") %></p>
            <p class="col-span-3 text-right"><%= t(".transfers.net_this_month") %></p>
            <p class="col-span-3"><%= t(".setup.bucket") %></p>
          </div>
          <% @plan.transfer_rows.each do |row| %>
            <div class="grid grid-cols-12 gap-3 items-center py-2.5">
              <p class="col-span-6 text-sm text-primary truncate"><%= row.account.name %></p>
              <p class="col-span-3 text-sm text-secondary tabular-nums text-right privacy-sensitive"><%= format_money(Money.new(row.net, @budget.family.currency)) %></p>
              <div class="col-span-3">
                <%= select_tag "account_buckets[#{row.account.id}]",
                    options_for_select([ [ t(".setup.unassigned_option"), "" ] ] + @bucket_options, row.account.csp_bucket),
                    class: "form-field__input w-full text-sm" %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="pt-4 flex justify-end">
          <%= render DS::Button.new(text: t(".transfers.save"), type: :submit) %>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".transfers.empty") %></p>
    <% end %>
  </section>
</div>
